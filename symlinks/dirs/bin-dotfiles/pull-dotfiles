#!/usr/bin/env bash

set -eu

if ! type git > /dev/null 2>&1; then
    echo "[Error] 'git' command not found."
    exit 1
fi

DOTFILES_PATH="$(realpath ~/dotfiles)"
INIT_FILE="${DOTFILES_PATH}/initialize.zsh"

echo "Updating dotfiles in ${DOTFILES_PATH}."
cd "${DOTFILES_PATH}"
echo "Running: git pull"
git pull
echo "Running: ${INIT_FILE}"
zsh "${INIT_FILE}"
echo "Updated dotfiles."

echo "Updating Prezto in ${HOME}/.zprezto."
cd "${HOME}/.zprezto"
echo "Running: git pull"
git pull
echo "Running: git submodule update --init --recursive"
git submodule update --init --recursive
echo "Updated Prezto."

if type mise > /dev/null 2>&1; then
    echo "Updating mise tools."
    echo "Running: mise upgrade"
    mise upgrade
    echo "Updated mise tools."
else
    echo "[Warning] 'mise' command not found. Skipped updating mise tools."
fi
